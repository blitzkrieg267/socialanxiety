# Caddy automatically provisions and renews a Let's Encrypt certificate for
# $POSTIZ_DOMAIN, then reverse-proxies every request (frontend, /api backend,
# and websockets) to the Postiz container on its internal port 5000.
#
# $POSTIZ_DOMAIN and $ACME_EMAIL are injected from .env via the caddy service.

{
	email {$ACME_EMAIL}
}

{$POSTIZ_DOMAIN} {
	encode zstd gzip

	# Upload-friendly: Postiz handles media uploads, so don't cap body size.
	request_body {
		max_size 0
	}

	reverse_proxy postiz:5000 {
		# Preserve the original host/scheme so Postiz builds correct links.
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}
}
